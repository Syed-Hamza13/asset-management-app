NODE_ENV=development
HOST=0.0.0.0
PORT=3000
FRONTEND_URL=http://localhost:5173
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
SESSION_SECRET=replace_with_a_long_random_secret
TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key
SESSION_MAX_AGE_MS=86400000

# Phase 4 - email notifications
# Encrypts the stored SMTP password at rest (AES-256-GCM). REQUIRED before saving
# an SMTP password. Must be at least 32 characters and must stay stable: changing it
# makes the previously stored SMTP password undecryptable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
SMTP_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars
# In-process delivery worker (single-container deployment). Uses a MySQL GET_LOCK so
# only one process sends at a time. Set to false to disable sending.
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5

# Network restriction (IP allowlist), managed from Settings.
# Break-glass: set to false and restart if an allowlist mistake locks every admin out.
IP_ACCESS_ENFORCE=true
# Leave empty when nothing is in front of this app (direct access, localhost, dev).
# When a reverse proxy such as nginx forwards requests, list the proxy machine's
# address here (comma-separated, CIDR allowed) or the allowlist sees the proxy's IP
# for every visitor instead of the visitor's own:
#   IP_ACCESS_TRUSTED_PROXIES=192.168.1.10,172.17.0.1
IP_ACCESS_TRUSTED_PROXIES=
